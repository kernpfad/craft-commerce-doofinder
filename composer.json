{
    "name": "kernpfad/commerce-doofinder",
    "description": "A Doofinder integration for Craft Commerce: real-time product/variant sync to a Doofinder search index plus a zero-downtime full-catalog reindex command. Doofinder's own drop-in search widget handles the front end.",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "commerce",
        "doofinder",
        "search",
        "catalog"
    ],
    "license": "proprietary",
    "support": {
        "email": "rene.neuburger@gmx.de",
        "docs": "https://github.com/kernpfad/commerce-doofinder",
        "issues": "https://github.com/kernpfad/commerce-doofinder/issues"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0",
        "craftcms/commerce": "^5.0.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "craftcms/rector": "dev-main",
        "phpunit/phpunit": "^11.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "kernpfad\\commercedoofinder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "kernpfad\\commercedoofinder\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "commerce-doofinder",
        "name": "Commerce Doofinder",
        "developer": "Kernpfad",
        "documentationUrl": "https://github.com/kernpfad/commerce-doofinder",
        "class": "kernpfad\\commercedoofinder\\CommerceDoofinder",
        "changelogUrl": "https://raw.githubusercontent.com/kernpfad/commerce-doofinder/main/CHANGELOG.md",
        "developerUrl": "https://kernpfad.dev",
        "imprintUrl": "https://kernpfad.dev/en/legal-notice",
        "privacyPolicyUrl": "https://kernpfad.dev/en/privacy-policy",
        "termsUrl": "https://kernpfad.dev/en/terms-and-conditions"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        },
        "preferred-install": "source"
    },
    "scripts": {
        "check-cs": "ecs check",
        "fix-cs": "ecs check --fix",
        "phpstan": "phpstan analyse",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
